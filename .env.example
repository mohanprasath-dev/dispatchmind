# DispatchMind Environment Configuration
# Minimum requirement for DEMO_MODE: GOOGLE_API_KEY

# Demo mode (set true to use local JSON store and offline mocks)
DEMO_MODE=true

# Google Gemini API key (required)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Google Cloud project and services (optional in DEMO_MODE)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=

# Google Maps Platform (optional in DEMO_MODE, falls back to haversine)
GOOGLE_MAPS_API_KEY=

# Telegram notification bot (optional in DEMO_MODE, falls back to console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DISPATCHER_CHAT_ID=

# Operational settings
MONITOR_INTERVAL_SEC=30
AUTO_APPLY_MAX_DELAY_MIN=20
LOCAL_STORE_DIR=./data/local_store
